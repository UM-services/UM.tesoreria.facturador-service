sequenceDiagram
    autonumber
    participant C as Cliente API
    participant EC as EmisionController
    participant ES as EmisionService
    participant FP as FacturarPagoUseCaseImpl
    participant FE as FacturacionElectronicaService
    participant CP as ChequeraPagoService
    participant CU as ChequeraCuotaService
    participant CO as ComprobanteService
    participant AF as FacturacionAfipService

    C->>+EC: GET /api/tesoreria/facturador/facturaOne/{chequeraPagoId}
    EC->>+ES: facturaOne(chequeraPagoId)
    ES->>+FP: facturarPago(chequeraPagoId)
    FP->>+FE: getByChequeraPagoId(chequeraPagoId)
    FE-->>-FP: Sin facturación previa
    FP->>+CP: getById(chequeraPagoId)
    CP-->>-FP: ChequeraPago
    FP->>FP: facturarCuota(chequeraPago)
    opt La cuota no vino asociada al pago
        FP->>+CU: getByUnique(facultad, tipoChequera, serie, producto, alternativa, cuota)
        CU-->>-FP: ChequeraCuota
    end
    FP->>+CO: getById(14)
    CO-->>-FP: Comprobante
    FP->>+AF: test()
    AF-->>-FP: Estado del servicio
    FP->>+AF: facturar(SolicitudFacturacionAfip)
    AF-->>-FP: RespuestaFacturacionAfip con CAE
    FP->>+FE: registrar(FacturacionElectronica)
    FE-->>-FP: Facturación registrada
    FP-->>-ES: "Facturado Ok" o "Facturado NO"
    ES-->>-EC: Resultado
    EC-->>-C: 200 OK
